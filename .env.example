# =============================================================================
# farmer - gizli bilgiler (.env.example)
#
# Kullanım:  cp .env.example .env   ve değerleri doldurun.  .env dosyasını ASLA paylaşmayın / git'e eklemeyin
# (.gitignore'da zaten var). Dosya izinlerini kısıtlayın:  chmod 600 .env
# Ortam değişkenleri .env'den önceliklidir (ör. systemd/docker ile verilenler).
# =============================================================================

# --- Arcus (maker bacağı) ------------------------------------------------------
# Ana cüzdan (EVM) adresi: Arcus hesabınızın sahibi. Mainnet erişimi beyaz liste / davet kodu gerektirir.
ARCUS_ADDRESS=
# Bot için kaydedilmiş Ed25519 API anahtarının ÖZEL kısmı (64 hex). `farmer keygen arcus` üretir.
# API anahtarları yalnızca işlem yetkilidir (para çekemez).
ARCUS_API_PRIVATE_KEY=
# Alt hesap numarası 0..9 (config.yaml'daki arcus.account_index'i geçersiz kılar). Bot için ayrı alt hesap önerilir.
ARCUS_ACCOUNT_INDEX=0

# --- Lighter (taker/hedge bacağı) ----------------------------------------------
# Lighter API anahtarının özel kısmı (0x + 80 hex). `farmer keygen lighter` üretir ve kaydeder.
LIGHTER_API_PRIVATE_KEY=
# Lighter hesap numarası (L1 adresinizin ana hesabı; keygen otomatik bulur).
LIGHTER_ACCOUNT_INDEX=
# API anahtar yuvası 4..254 (0-3 Lighter uygulamalarına ayrılmıştır). Her bot süreci kendi yuvasını kullanmalı.
LIGHTER_API_KEY_INDEX=4

# --- Yalnızca `farmer keygen` için (bot çalışırken GEREKMEZ; kayıttan sonra silin) -----------------
# Arcus ana cüzdan özel anahtarı: createApiKey EIP-712 imzası için YEREL olarak kullanılır, gönderilmez/yazdırılmaz.
# ARCUS_WALLET_PRIVATE_KEY=
# Lighter hesabının sahibi olan L1 (Ethereum) cüzdan özel anahtarı: ChangePubKey imzası için yerel kullanılır.
# LIGHTER_ETH_PRIVATE_KEY=

# --- Telegram bildirimleri (opsiyonel; ikisi de doluysa açılır) ---------------------------------
# @BotFather ile bot oluşturun; chat id için bota mesaj atıp https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Opsiyonel ---------------------------------------------------------------------------------
# config.yaml'daki `mode` değerini geçersiz kılar: paper | live
# FARMER_MODE=paper
